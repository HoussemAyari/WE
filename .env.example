# Use a NEW Supabase project dedicated to DeuxNous. Project ref supplied: ofmpmilantcvqkonzkns.
# Find the pooler hostname/region in Supabase: Connect -> Connection string -> Transaction pooler.
# Replace [YOUR-DATABASE-PASSWORD] with the database password and [REGION] with the region shown there.
# DATABASE_URL: Transaction pooler (port 6543) for serverless app requests.
DATABASE_URL="postgresql://postgres.ofmpmilantcvqkonzkns:[YOUR-DATABASE-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# The provided direct endpoint is used here for Prisma migrations; it may be IPv6-only.
# If unreachable, use Connect -> Connection string -> Session pooler (port 5432) instead.
DIRECT_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.ofmpmilantcvqkonzkns.supabase.co:5432/postgres"

# Generate a new unique secret for Better Auth: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-new-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth web client (see the Google Cloud Console section in README.md).
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Resend sends verification and password-reset links. Use a verified sending domain.
RESEND_API_KEY="replace-with-a-new-resend-api-key"
EMAIL_FROM="DeuxNous <auth@example.com>"

# From the same NEW Supabase project. Never commit the secret key; rotate the key that was exposed.
SUPABASE_URL="https://ofmpmilantcvqkonzkns.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-a-new-rotated-server-secret-key"
SUPABASE_STORAGE_BUCKET="deuxnous-private"

# Generate another random value; used only by the scheduled recurring transaction endpoint.
CRON_SECRET="replace-with-a-different-random-secret"
